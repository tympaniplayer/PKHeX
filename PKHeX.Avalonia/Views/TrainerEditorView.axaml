<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PKHeX.Avalonia.ViewModels"
             x:Class="PKHeX.Avalonia.Views.TrainerEditorView"
             x:DataType="vm:TrainerEditorViewModel">

    <ScrollViewer Padding="12">
        <StackPanel Spacing="12">
            <TextBlock Text="Trainer Info" FontSize="20" FontWeight="Bold" />
            <TextBlock Text="{Binding GameVersion}" Opacity="0.6" />

            <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="8">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" VerticalAlignment="Center" />
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding TrainerName}" MaxLength="12" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="TID" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding TID16}" Minimum="0" Maximum="65535" FormatString="0" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="SID" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding SID16}" Minimum="0" Maximum="65535" FormatString="0" />

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Money" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding Money}" Minimum="0" Maximum="9999999" FormatString="$#,0" />

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Gender" VerticalAlignment="Center" />
                <ComboBox Grid.Row="4" Grid.Column="1" SelectedIndex="{Binding Gender}">
                    <ComboBoxItem Content="♂ Male" />
                    <ComboBoxItem Content="♀ Female" />
                </ComboBox>

                <TextBlock Grid.Row="5" Grid.Column="0" Text="Play Time" VerticalAlignment="Center" />
                <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Spacing="4">
                    <NumericUpDown Value="{Binding PlayedHours}" Minimum="0" Maximum="9999" FormatString="0" Width="80" />
                    <TextBlock Text="h" VerticalAlignment="Center" />
                    <NumericUpDown Value="{Binding PlayedMinutes}" Minimum="0" Maximum="59" FormatString="00" Width="60" />
                    <TextBlock Text="m" VerticalAlignment="Center" />
                    <NumericUpDown Value="{Binding PlayedSeconds}" Minimum="0" Maximum="59" FormatString="00" Width="60" />
                    <TextBlock Text="s" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <Button Content="Apply Changes" Command="{Binding ApplyCommand}" HorizontalAlignment="Left" Padding="16,6" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
