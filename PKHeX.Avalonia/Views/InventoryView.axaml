<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PKHeX.Avalonia.ViewModels"
             x:Class="PKHeX.Avalonia.Views.InventoryView"
             x:DataType="vm:InventoryViewModel">

    <DockPanel Margin="8">
        <TextBlock DockPanel.Dock="Top" Text="Inventory" FontSize="20" FontWeight="Bold" Margin="4,4,4,8" />

        <!-- Pouch selector tabs -->
        <TabControl ItemsSource="{Binding Pouches}"
                    SelectedItem="{Binding SelectedPouch}">
            <TabControl.ItemTemplate>
                <DataTemplate x:DataType="vm:InventoryPouchViewModel">
                    <TextBlock Text="{Binding Name}" />
                </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.ContentTemplate>
                <DataTemplate x:DataType="vm:InventoryPouchViewModel">
                    <DataGrid ItemsSource="{Binding Items}"
                              AutoGenerateColumns="False"
                              CanUserSortColumns="True"
                              IsReadOnly="False"
                              GridLinesVisibility="Horizontal"
                              Margin="0,4">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Item" Binding="{Binding ItemName}" Width="*" IsReadOnly="True" />
                            <DataGridTextColumn Header="ID" Binding="{Binding ItemId}" Width="60" IsReadOnly="True" />
                            <DataGridTextColumn Header="Count" Binding="{Binding Count}" Width="80" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>
    </DockPanel>
</UserControl>
