<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PKHeX.Avalonia.ViewModels"
             x:Class="PKHeX.Avalonia.Views.SearchView"
             x:DataType="vm:SearchViewModel">

    <DockPanel Margin="8">
        <TextBlock DockPanel.Dock="Top" Text="Search Pokemon" FontSize="20" FontWeight="Bold" Margin="4,4,4,8" />

        <!-- Filters -->
        <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="4">
            <Grid ColumnDefinitions="80,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="4" ColumnSpacing="8">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" VerticalAlignment="Center" />
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SearchText}" Watermark="Search by name..." />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Species" VerticalAlignment="Center" />
                <ComboBox Grid.Row="1" Grid.Column="1"
                          ItemsSource="{Binding SpeciesList}"
                          SelectedValue="{Binding FilterSpecies}"
                          SelectedValueBinding="{Binding Value}"
                          DisplayMemberBinding="{Binding Text}"
                          HorizontalAlignment="Stretch" />

                <CheckBox Grid.Row="2" Grid.Column="1" Content="Shiny Only" IsChecked="{Binding FilterShinyOnly}" />
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Search" Command="{Binding SearchCommand}" Padding="16,4" />
                <Button Content="Clear" Command="{Binding ClearSearchCommand}" Padding="16,4" />
                <TextBlock VerticalAlignment="Center" Opacity="0.6">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="{}{0} results">
                            <Binding Path="ResultCount" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </StackPanel>
        </StackPanel>

        <!-- Results grid -->
        <ItemsControl ItemsSource="{Binding Results}" Margin="4,8,4,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SearchResultViewModel">
                    <Border Padding="4" Margin="2" CornerRadius="4" Width="180"
                            Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                            ToolTip.Tip="{Binding Location}">
                        <DockPanel>
                            <Image Source="{Binding Sprite}" Width="48" Height="40"
                                   Stretch="Uniform" DockPanel.Dock="Left" Margin="0,0,6,0" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Summary}" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Location}" FontSize="10" Opacity="0.6" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DockPanel>
</UserControl>
